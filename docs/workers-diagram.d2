vars: {
  d2-config: {
    layout-engine: elk
    # Terminal theme code
    theme-id: 300
  }
}

direction: right

title: "Patchworks Worker Modes (workers.enabled)" {
  shape: text
  near: top-center
  style.font-size: 20
}

# ── processors[] ────────────────────────────────────────────────────────────

processors: "processors[] (always PHP Core)" {
  style.fill: "#FFF8E6"
  direction: down

  desc: "Background processor queues are independent of workers.type.\nprocessorDeployments.enabled and scheduler.enabled independently select Deployments and CronJobs.\nrabbitmq.topology.enabled independently selects the queue assertion hook.\nDatabase connections: LANDLORD_DB_* and TENANT_DB_* / TENANT_DB_*_{id}." {
    shape: text
  }

  processor: "Per Processor" {
    style.stroke-dash: 4
    direction: right
    topology: "Job\n{name}-rabbitmq-topology" { shape: rectangle }
    cm: "{name}-processor-{queue}-supervisord\nqueue: processors[].queue" { shape: document }
    dep: "Deployment\n{name}-processor-{queue}" { shape: rectangle }
    cron: "CronJob\n{name}-{queue}-scheduler" { shape: rectangle }
    queue: "RabbitMQ queue\nquorum durable" { shape: queue }
    topology -> queue: declares
    cm -> dep: mounts
    dep -> queue: consumes
    cron -> queue: APP_DOMAIN
  }
}

# ── type: standalone ────────────────────────────────────────────────────────

standalone: "type: standalone" {
  style.fill: "#EDF2FF"
  direction: down

  desc: "One queue worker via supervisord.\nConcurrency controlled by workers.processes (numprocs).\nDatabase connections: LANDLORD_DB_* and TENANT_DB_* / TENANT_DB_*_{id}." {
    shape: text
  }

  hub: "Hub (workers.hub.enabled)" {
    direction: right
    cm: "{name}-workers-supervisord\nqueue: workers.queue.name" { shape: document }
    dep: "Deployment\n{name}-workers" { shape: rectangle }
    cm -> dep: mounts
  }

  company: "Per-Company (independent of hub)" {
    style.stroke-dash: 4
    direction: right
    cm: "{name}-workers-{co}-supervisord\nqueue: company.queue" { shape: document }
    dep: "Deployment\n{name}-workers-{co}" { shape: rectangle }
    cm -> dep: mounts
  }

  hub -> company: "× workers.companies[]"
}

# ── type: microservice ───────────────────────────────────────────────────────

microservice: "type: microservice" {
  style.fill: "#FFF0F0"
  direction: down

  desc: "One worker per service key in workers.microservices.\n_default provides fallbacks for all fields.\nDatabase connections: LANDLORD_DB_* and TENANT_DB_* / TENANT_DB_*_{id}." {
    shape: text
  }

  service: "Per Service (workers.microservices[])" {
    style.stroke-dash: 4
    direction: down

    hub: "Hub (workers.hub.enabled)" {
      direction: right
      cm: "{name}-workers-{svc}-supervisord\nqueue: domain" { shape: document }
      dep: "Deployment\n{name}-workers-{svc}" { shape: rectangle }
      cm -> dep: mounts
    }

    company: "Per-Company (independent of hub)" {
      style.stroke-dash: 4
      direction: right
      cm: "{name}-workers-{svc}-{co}-supervisord\nqueue: company.queue" { shape: document }
      dep: "Deployment\n{name}-workers-{svc}-{co}" { shape: rectangle }
      cm -> dep: mounts
    }

    hub -> company: "× workers.companies[]"
  }
}

# ── type: mono ───────────────────────────────────────────────────────────────

mono: "type: mono" {
  style.fill: "#F0FFF4"
  direction: down

  desc: "Monocore Go worker. RabbitMQ topology asserted at startup via topology.yaml.\nOptional workers.mono.serviceMonitor.enabled: one ServiceMonitor per worker namespace, metrics :8081.\nDatabase connections: DB_LANDLORD_* and DB_TENANT_* / DB_TENANT_{id}_*.\nTENANT_DB_* compatibility aliases also supplied.\nTenant registry selects the schema and server; company queue does not select a database." {
    shape: text
  }

  hub: "Hub (workers.hub.enabled)" {
    direction: right
    topology: "{name}-workers-topology\ntopology.yaml\nflows + optional flow exchange" { shape: document }
    store:    "{name}-workers-store or existing Secret\nstore.yaml\nS3 endpoint + credentials" { shape: document }
    config:   "{name}-workers-config\nconfig.yaml\nqueue: workers.mono.queue" { shape: document }
    dep:      "Deployment\n{name}-workers"                      { shape: rectangle }
    topology -> dep: mounts
    store    -> dep: mounts
    config   -> dep: mounts
  }

  company: "Per-Company (independent of hub)" {
    style.stroke-dash: 4
    direction: right
    config: "{name}-workers-{co}-config\nconfig.yaml"           { shape: document }
    dep:    "Deployment\n{name}-workers-{co}"                   { shape: rectangle }
    config -> dep: mounts
  }

  hub -> company: "× workers.companies[]\nbinds queues when companyFlows.enabled\ntopology + store Secret in selected namespaces"
}
