vars: {
  d2-config: {
    layout-engine: elk
    # Terminal theme code
    theme-id: 300
  }
}

direction: right

title: Patchworks Worker Modes {
  shape: text
  near: top-center
  style.font-size: 20
}

# ── type: standalone ────────────────────────────────────────────────────────

standalone: "type: standalone" {
  style.fill: "#EDF2FF"
  direction: down

  desc: "One queue worker via supervisord.\nConcurrency controlled by workers.processes (numprocs)." {
    shape: text
  }

  hub: Hub {
    direction: right
    cm: "{name}-workers-supervisord\nqueue: workers.queue.name" { shape: document }
    dep: "Deployment\n{name}-workers" { shape: rectangle }
    cm -> dep: mounts
  }

  company: "Per-Company (optional)" {
    style.stroke-dash: 4
    direction: right
    cm: "{name}-workers-{co}-supervisord\nqueue: company.queue" { shape: document }
    dep: "Deployment\n{name}-workers-{co}" { shape: rectangle }
    cm -> dep: mounts
  }

  hub -> company: "× workers.companies[]"
}

# ── type: microservice ───────────────────────────────────────────────────────

microservice: "type: microservice" {
  style.fill: "#FFF0F0"
  direction: down

  desc: "One worker per service key in workers.microservices.\n_default provides fallbacks for all fields." {
    shape: text
  }

  service: "Per Service (workers.microservices[])" {
    style.stroke-dash: 4
    direction: down

    hub: Hub {
      direction: right
      cm: "{name}-workers-{svc}-supervisord\nqueue: domain" { shape: document }
      dep: "Deployment\n{name}-workers-{svc}" { shape: rectangle }
      cm -> dep: mounts
    }

    company: "Per-Company (optional)" {
      style.stroke-dash: 4
      direction: right
      cm: "{name}-workers-{svc}-{co}-supervisord\nqueue: company.queue" { shape: document }
      dep: "Deployment\n{name}-workers-{svc}-{co}" { shape: rectangle }
      cm -> dep: mounts
    }

    hub -> company: "× workers.companies[]"
  }
}

# ── type: mono ───────────────────────────────────────────────────────────────

mono: "type: mono" {
  style.fill: "#F0FFF4"
  direction: down

  desc: "Monocore Go worker. RabbitMQ topology asserted at startup via topology.yaml." {
    shape: text
  }

  hub: Hub {
    direction: right
    topology: "{name}-workers-topology\ntopology.yaml\nflows + optional flow exchange" { shape: document }
    store:    "{name}-workers-store or existing Secret\nstore.yaml\nS3 endpoint + credentials" { shape: document }
    config:   "{name}-workers-config\nconfig.yaml\nqueue: workers.mono.queue" { shape: document }
    dep:      "Deployment\n{name}-workers"                      { shape: rectangle }
    topology -> dep: mounts
    store    -> dep: mounts
    config   -> dep: mounts
  }

  company: "Per-Company (optional)" {
    style.stroke-dash: 4
    direction: right
    config: "{name}-workers-{co}-config\nconfig.yaml"           { shape: document }
    dep:    "Deployment\n{name}-workers-{co}"                   { shape: rectangle }
    config -> dep: mounts
  }

  hub -> company: "× workers.companies[]\nbinds queues when companyFlows.enabled\ntopology copied + store Secret generated if cross-ns"
}
