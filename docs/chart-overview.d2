vars: {
  d2-config: {
    layout-engine: elk
    # Terminal theme code
    theme-id: 300
  }
}

direction: right

title: "Patchworks Helm Chart — Component Overview" {
  shape: text
  near: top-center
  style.font-size: 20
}

application: "Application (components independently selectable)" {
  style.fill: "#EDF2FF"

  web: "Gateway / Start\nweb.gateway.enabled / web.start.enabled" { shape: rectangle }
  scheduler: "Processor Schedulers\nscheduler.enabled" { shape: rectangle }
  processors: "Core Processors\nprocessorDeployments.enabled" { shape: rectangle }
  s3manager: "S3 Manager\n(S3_BUCKET_CREATION_ENDPOINT)" { shape: rectangle }

  workers: "Workers (workers.enabled)" {
    standalone:   "standalone\nPHP via supervisord" { shape: rectangle }
    microservice: "microservice\nPHP × N services"  { shape: rectangle }
    mono:         "mono\nMonocore Go"               { shape: rectangle }
  }

  migrations: "Migrations Job\npre-install / pre-upgrade" { shape: rectangle }
}

infra: "Infrastructure (in-cluster or external)" {
  style.fill: "#F0FFF4"

  mysql:         "MySQL 8.0\nBundled default server\nmysql.databases: additional schemas" { shape: cylinder }
  landlord:      "Landlord database\ndatabase.landlord\nMySQL defaults or separate server" { shape: cylinder }
  tenants:       "Tenant databases\ndatabase.tenant + servers by credential ID\nschema selected from tenant registry" { shape: cylinder }
  redis:         "Redis / Valkey\n(REDIS_*)"              { shape: cylinder }
  rabbitmq:      "RabbitMQ 3\n(RABBITMQ_*)"               { shape: queue    }
  elasticsearch: "Elasticsearch 8\n(ELASTICSEARCH_HOST)"  { shape: cylinder }
  s3:            "MinIO / S3\n(AWS_*)"                    { shape: cylinder }
  credentials:   "Credential Generator\n(pre-install / pre-upgrade)" { shape: rectangle }

  credentials -> mysql: creates Secret
  credentials -> rabbitmq: creates Secret
  credentials -> elasticsearch: creates Secret
  credentials -> s3: creates Secret
}

optional: "Optional Integrations" {
  style.fill: "#FDF4FF"
  style.stroke-dash: 4

  kubefaas: "KubeFaaS\nkubefaas.enabled" {
    controller: Controller { shape: rectangle }
    builder:    "Builder\n(dind + mTLS)"   { shape: rectangle }
    kfredis:    "Redis (dedicated)"        { shape: cylinder }
    functions:  "Function Namespaces\n(N × Namespace + ServiceAccount)" {
      shape: rectangle
      style.stroke-dash: 4
    }
    controller -> kfredis
    builder    -> kfredis
    controller -> functions: manages
  }

  soketi: "Soketi\n(PUSHER_*)" { shape: rectangle }
}

application.web -> optional.soketi: PUSHER_*
application.workers -> optional.soketi: PUSHER_*
application.processors -> infra.rabbitmq: RABBITMQ_QUEUE
application.scheduler -> infra.rabbitmq: RABBITMQ_QUEUE
application.web -> application.s3manager: S3_BUCKET_CREATION_ENDPOINT
application.workers -> application.s3manager: S3_BUCKET_CREATION_ENDPOINT
application.s3manager -> infra.s3: AWS_*
application -> infra.mysql: "mysql.* connection defaults"
application -> infra.landlord: "Core LANDLORD_DB_* / DB_*\nMonocore DB_LANDLORD_*"
application -> infra.tenants: "Core TENANT_DB_* / TENANT_DB_*_{id}\nMonocore DB_TENANT_* / DB_TENANT_{id}_*"
